{
  "buildCommand": "npm install && npx bun scripts/lint-prompts.ts && node scripts/check-api-imports.js && npx bun site/build-static.ts",
  "outputDirectory": "site/public",
  "crons": [],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co https://api.anthropic.com https://api.resend.com" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/build-report", "destination": "/api/build-report" },
    { "source": "/api/send-briefing", "destination": "/api/send-briefing" },
    { "source": "/api/db", "destination": "/api/db" },
    { "source": "/api/daily-scan", "destination": "/api/daily-scan" },
    { "source": "/api/detect-corrections", "destination": "/api/detect-corrections" },
    { "source": "/api/cron-weekly-summary", "destination": "/api/cron-weekly-summary" },
    { "source": "/api/cron-weekly", "destination": "/api/cron-weekly" },
    { "source": "/api/status", "destination": "/api/status" },
    { "source": "/api/backfill", "destination": "/api/backfill" },
    { "source": "/api/rematch-companies", "destination": "/api/rematch-companies" },
    { "source": "/api/auto-heal", "destination": "/api/auto-heal" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/reports/poc-(.*)", "destination": "/reports/poc-removed-404.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
